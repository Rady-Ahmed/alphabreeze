# ==========================================
# AlphaBreeze Production Environment Variables
# ==========================================

# 1. Base URL for API routes and absolute links (Required)
NEXT_PUBLIC_BASE_URL="https://alphabreeze.com" # Change to your actual domain in production
NEXT_PUBLIC_SITE_URL="https://alphabreeze.com"
NEXT_PUBLIC_SITE_NAME="AlphaBreeze"

# 2. Supabase - Database and Auth (Required for production backend)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# 3. Email Notifications using Resend (Optional but recommended)
RESEND_API_KEY="re_..."
FROM_EMAIL="AlphaBreeze <orders@alphabreeze.com>"
ADMIN_EMAIL="admin@alphabreeze.com"

# 4. Analytics and Tracking (Optional but recommended)
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX" # Google Analytics 4 ID
NEXT_PUBLIC_META_PIXEL_ID="XXXXXXXXXXXXXXXX" # Meta (Facebook) Pixel ID
NEXT_PUBLIC_TIKTOK_PIXEL_ID="XXXXXXXXXXXXXXXXXX" # TikTok Pixel ID
